    {
      "id": "brand.nulumin",
      "type": "brand",
      "name": "NuLumin Bio-Sciences",
      "aliases": [
        "nulumin",
        "nu lumin",
        "nulumin biosciences"
      ],
      "source": "Brand Context/NuLumin_BioSciences.md",
      "complianceProfile": "regulated-health-ruo",
      "pack": "knowledge/brands/nulumin",
      "promptProfile": {
        "designSystem": "knowledge/brands/nulumin/design-system.json is authoritative for exact hexes and type. It separates the marketing palette (ads, web, email) from the packaging palette (vial-label art); the two are not interchangeable.",
        "positioning": "Clinical-modern research peptide brand; refined biotech, not energy drink or bodybuilding hype.",
        "palette": [
          "cream #F4F0E6",
          "purple #A78BFA",
          "blue #60A5FA",
          "green #34D399",
          "gold #FBBF24",
          "pink #F472B6"
        ],
        "visualLanguage": [
          "Aesop x Apple x biotech restraint",
          "real glass and label geometry",
          "category color used as an accent",
          "controlled whitespace"
        ],
        "mustPreserve": [
          "NuLumin wordmark geometry",
          "product name and dose",
          "category color",
          "real package/vial proportions"
        ],
        "avoid": [
          "invented certifications",
          "fake COA text",
          "medical outcomes",
          "human-use depiction",
          "energy-drink neon overload"
        ]
      }
    },
