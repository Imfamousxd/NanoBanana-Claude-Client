    {
      "id": "assets.nulumin-product",
      "type": "asset-collection",
      "name": "NuLumin canonical product assets",
      "paths": [
        "NuLumin Generated/NuLumin Vial Library",
        "NuLumin Generated/Hero Shots v3 (fixed)/retail"
      ],
      "selectionRule": "Start at NuLumin Generated/NuLumin Vial Library — all 66 retail SKUs as transparent PNGs and white-background JPEGs, plus the 5 category heroes, resolved through its index.json (compound, dose, category, accent hex, cake, glass, both paths). Use Transparent/ to composite, White/ on white, and Category Heroes/ as the reference when generating a new SKU. The corner heroes are the composed hero shots and the colour authority. Older folders (White BG Powder, Transparent_*, nobg*, One-Per-Peptide, Vial Library v2) are superseded — see knowledge/brands/nulumin/ASSETS.md."
    },
    {
      "id": "pack.nulumin",
      "type": "brand-pack",
      "name": "NuLumin brand pack",
      "aliases": [
        "nulumin pack",
        "nulumin brandkit",
        "nulumin ads"
      ],
      "source": "knowledge/brands/nulumin/README.md",
      "directory": "knowledge/brands/nulumin",
      "provides": [
        "exact design tokens for marketing and packaging surfaces",
        "compound catalog with category accents and prompt-critical cap/cake colors",
        "interchangeable selling-point matrix mapped to claim records",
        "verbatim Nano Banana hero-scene prompt blocks and the styles that were dropped",
        "three approved static-ad formats with their layout law and rejection history"
      ],
      "commands": [
        "npm run content -- brandkit kit nulumin",
        "npm run content -- brandkit fonts nulumin",
        "npm run content -- brandkit ad nulumin single|panel|streak",
        "npm run content -- brandkit job nulumin hero"
      ]
    },
    {
      "id": "assets.nulumin-ads",
      "type": "asset-collection",
      "name": "NuLumin ad artwork",
      "paths": [
