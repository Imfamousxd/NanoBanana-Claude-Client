    {
      "id": "rule.image-provider-routing",
      "type": "routing-rule",
      "name": "Image provider routing",
      "aliases": [
        "provider routing",
        "which model",
        "gpt-image-2 vs nano banana",
        "image model choice"
      ],
      "source": "docs/IMAGE_KNOWLEDGE_GRAPH.md",
      "rules": [
        "Default provider is gpt-image-2; switch to Nano Banana (gemini-3-pro-image-preview) for hero-scale reference fidelity.",
        "NEVER composite/PIL-paste product art into a scene — generate the whole graphic with the real assets passed as references.",
        "Transparent-background output = gpt-image-1 only.",
        "If a supplied product render's own printed copy must stay correct, use gpt-image-2 /v1/images/edits with the render as the edit base.",
        "gpt-image-2 quality:high dies at the ~60s connection cap — use quality:medium and rebuild FormData per retry.",
        "gpt-image-2 cannot output 9:16; video ads are always 9:16 (house format).",
        "On-image copy is supplied verbatim; long/legal/tabular copy is composed deterministically after generation."
      ]
    },
