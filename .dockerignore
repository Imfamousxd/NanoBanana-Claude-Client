# Docker build context for the DAM worker: only what deploy/dam/Dockerfile copies, plus the
# Dockerfile itself (Railway's builder needs it INSIDE the context — excluding it fails the build
# before any log line is written).
*
!package.json
!package-lock.json
!railway.toml
!deploy/**
!engine/**
!knowledge/**
!schemas/**
!docs/**
!Brand Context/**
**/.DS_Store
**/*.psd
**/*.mov
**/*.mp4
**/node_modules
